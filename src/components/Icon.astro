  scale:
    '<path d="M16 3h5v5"/><path d="M8 3H3v5"/><path d="M12 22v-8"/><path d="M3 12h18"/><path d="m7 12-2.5 5.5a3 3 0 0 0 5 0L7 12"/><path d="m17 12-2.5 5.5a3 3 0 0 0 5 0L17 12"/>',
  menu: '<path d="M4 6h16M4 12h16M4 18h16"/>',
  x: '<path d="M18 6 6 18M6 6l12 12"/>',
  // business-specific trio: metal can, glass jar, vacuum bag
  can:
    '<path d="M6 5.5c0 .83 2.69 1.5 6 1.5s6-.67 6-1.5S15.31 4 12 4 6 4.67 6 5.5Z"/><path d="M6 5.5V18c0 .83 2.69 1.5 6 1.5s6-.67 6-1.5V5.5"/><path d="M6 11.5c0 .83 2.69 1.5 6 1.5s6-.67 6-1.5"/>',
