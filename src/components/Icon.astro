---
export interface Props {
  name: string;
  size?: number;
  stroke?: number;
  class?: string;
}
const { name, size = 22, stroke = 1.6, class: klass = "" } = Astro.props;

// Minimal outline icon set, modeled on Lucide's line-icon style (thin stroke,
// no fill, rounded caps). Business-specific packaging icons (can/jar/vacuum
// bag) live in Icon.astro too since no direct Lucide equivalent fits them.
