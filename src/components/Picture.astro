---
export interface Props {
  src: string;
  alt: string;
  width: number;
  height: number;
  loading?: "eager" | "lazy";
  fetchpriority?: "high" | "low" | "auto";
  class?: string;
}
const {
  src,
  alt,
  width,
  height,
  loading = "lazy",
  fetchpriority = "auto",
  class: klass = "",
} = Astro.props;
const webp = src.replace(/\.jpg$/, ".webp");
---

<picture>
  <source srcset={webp} type="image/webp" />
  <img
    src={src}
    alt={alt}
    width={width}
    height={height}
    loading={loading}
    decoding="async"
    fetchpriority={fetchpriority}
    class={klass}
  />
</picture>
