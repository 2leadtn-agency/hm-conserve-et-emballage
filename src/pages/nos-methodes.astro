---
import Layout from "../layouts/Layout.astro";
import Icon from "../components/Icon.astro";
---

<Layout
  title="Nos méthodes - HM Conserve et Emballage"
  description="Détail des méthodes de conservation HM Conserve et Emballage — page à venir."
  active="methodes"
>
  <section class="placeholder">
    <Icon name="jar" size={38} stroke={1.3} />
    <p>Contenu bientôt disponible</p>
  </section>
</Layout>

<style>
  .placeholder {
    min-height: 46vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 18px;
    padding: 90px 20px;
    color: var(--color-ink-soft);
    text-align: center;
  }
  .placeholder :global(svg) { color: var(--color-terracotta); }
  .placeholder p {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 1.4rem;
    color: var(--color-ink);
  }
</style>
